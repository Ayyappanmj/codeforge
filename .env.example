# Copy to .env and change the passwords. Never commit .env.
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=codeforge
RABBITMQ_USER=codeforge
RABBITMQ_PASSWORD=change-me-rabbit

# Group id of the docker socket on the host (Linux: `stat -c %g /var/run/docker.sock`).
DOCKER_GID=999

# Sandbox limits (validated at startup; clients cannot change them)
EXEC_TIMEOUT_SECONDS=5
EXEC_MEMORY_MB=128
EXEC_CPUS=1
EXEC_PIDS_LIMIT=32
MAX_SOURCE_BYTES=65536
MAX_STDIN_BYTES=16384
MAX_OUTPUT_BYTES=65536

# Reliability
MAX_ATTEMPTS=3
MAX_MESSAGE_RETRIES=3
RETRY_DELAY_MS=5000
LOG_LEVEL=INFO
